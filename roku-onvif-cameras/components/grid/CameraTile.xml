<?xml version="1.0" encoding="utf-8"?>
<!-- MarkupGrid item: live thumbnail, name and status for a camera, or an
     icon for an action tile. Positions are set by ApplyLayout for the
     item's layout. The grid draws the focus ring. -->
<component name="CameraTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="OnContent" />
    </interface>
    <script type="text/brightscript" uri="CameraTile.brs" />
    <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
    <children>
        <Rectangle id="card" color="0x1C232BFF" />
        <SnapshotPoster id="snapshot" />
        <Poster id="placeholder" width="160" height="160" uri="pkg:/images/tile_camera.png" />
        <Label id="placeholderText" horizAlign="center" color="0x9AA7B4FF" wrap="true" maxLines="2" />
        <Poster id="actionIcon" width="120" height="120" translation="[216,80]" visible="false" />
        <Rectangle id="labelStrip" color="0x000000B0" visible="false" />
        <Rectangle id="statusDot" width="16" height="16" color="0x6E7A88FF" />
        <Label id="title" vertAlign="center" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
        <Label id="subtitle" vertAlign="center" horizAlign="right" color="0xC8D1DAFF" ellipsizeOnBoundary="true" />
    </children>
</component>
